# Eworks OS — Environment Configuration
# Copy this file to .env and fill in your values

# ─── Claude / Anthropic ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── LinkedIn Credentials ─────────────────────────────────────────────────────
LINKEDIN_EMAIL=your_linkedin_email@example.com
LINKEDIN_PASSWORD=your_l...word

# ─── LinkedIn API (OAuth2 — for posting via official API) ─────────────────────
LINKEDIN_ACCESS_TOKEN=your_linkedin_oauth2_access_token_here
LINKEDIN_PERSON_URN=urn:li:person:YOUR_PERSON_ID_HERE

# ─── Telegram Bot ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_PATH=data/eworks.db

# ─── Session Storage ──────────────────────────────────────────────────────────
SESSION_DIR=session/

# ─── Agent Settings ───────────────────────────────────────────────────────────
DAILY_CONNECTION_LIMIT=20
ICP_SCORE_THRESHOLD=60.0

# ─── X.com (Twitter) API ─────────────────────────────────────────────────────
X_API_KEY=your_api_key
X_API_SECRET=your_api_secret
X_ACCESS_TOKEN=your_access_token
X_ACCESS_TOKEN_SECRET=your_access_token_secret
X_BEARER_TOKEN=your_bearer_token

# ─── Slack (Connector Agent) ──────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token-here
SLACK_INSTAGRAM_CHANNEL=C0XXXXXXXXX
SLACK_LINKEDIN_CHANNEL=C0XXXXXXXXX
SLACK_X_CHANNEL=C0XXXXXXXXX
SLACK_YOUTUBE_CHANNEL=C0XXXXXXXXX
SLACK_LEADS_CHANNEL=C0XXXXXXXXX

# ─── Instagram (Connector Agent) ──────────────────────────────────────────────
INSTAGRAM_ACCESS_TOKEN=your_ig_access_token_here
INSTAGRAM_ACCOUNT_ID=your_ig_account_id_here
