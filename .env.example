# Eworks OS — Environment Configuration
# Copy this file to .env and fill in your values

# ─── Claude / Anthropic ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── LinkedIn Credentials ─────────────────────────────────────────────────────
LINKEDIN_EMAIL=your_linkedin_email@example.com
LINKEDIN_PASSWORD=your_l...word

# ─── LinkedIn API (OAuth2 — for posting via official API) ─────────────────────
LINKEDIN_ACCESS_TOKEN=your_linkedin_oauth2_access_token_here
LINKEDIN_PERSON_URN=urn:li:person:YOUR_PERSON_ID_HERE

# ─── Telegram Bot ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_PATH=data/eworks.db

# ─── Session Storage ──────────────────────────────────────────────────────────
SESSION_DIR=session/

# ─── Agent Settings ───────────────────────────────────────────────────────────
DAILY_CONNECTION_LIMIT=20
ICP_SCORE_THRESHOLD=60.0

# ─── X.com (Twitter) API ─────────────────────────────────────────────────────
X_API_KEY=your_api_key
X_API_SECRET=your_api_secret
X_ACCESS_TOKEN=your_access_token
X_ACCESS_TOKEN_SECRET=your_access_token_secret
X_BEARER_TOKEN=your_bearer_token

# ─── Slack (Connector Agent) ──────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token-here
SLACK_INSTAGRAM_CHANNEL=C0XXXXXXXXX
SLACK_LINKEDIN_CHANNEL=C0XXXXXXXXX
SLACK_X_CHANNEL=C0XXXXXXXXX
SLACK_YOUTUBE_CHANNEL=C0XXXXXXXXX
SLACK_LEADS_CHANNEL=C0XXXXXXXXX

# ─── Instagram (Connector Agent) ──────────────────────────────────────────────
INSTAGRAM_ACCESS_TOKEN=your_ig_access_token_here
INSTAGRAM_ACCOUNT_ID=your_ig_account_id_here

# ─── Threads (Meta) ────────────────────────────────────────────────────────────
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# ─── Substack ──────────────────────────────────────────────────────────────────
SUBSTACK_EMAIL=
SUBSTACK_PASSWORD=
SUBSTACK_PUBLICATION_URL=

# ─── Slack — Threads & Substack channels ──────────────────────────────────────
SLACK_THREADS_CHANNEL=C0XXXXXXXXX
SLACK_SUBSTACK_CHANNEL=C0XXXXXXXXX

# === AIOX Variables (added 2026-07-14) ===
# Cost: ~$0.14/M tokens with tool calling support
DEEPSEEK_API_KEY=
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OpenAI API Key - Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Get your key at: https://exa.ai/
EXA_API_KEY=
# Usually free, no key required for basic usage
CONTEXT7_API_KEY=
# Get from your Supabase project settings
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=
# Get from: ClickUp Settings > Apps > API Token
CLICKUP_API_KEY=
# From your N8N instance settings
N8N_API_KEY=
N8N_WEBHOOK_URL=
# Sentry (error tracking)
SENTRY_DSN=
# Railway (deployment)
RAILWAY_TOKEN=
# Vercel (deployment)
VERCEL_TOKEN=
# --------------------------------------------
NODE_ENV=development
AIOX_VERSION=5.3.0

# AIOX_NOTE: The following variables already exist with different values:
# AIOX_SUGGESTED: ANTHROPIC_API_KEY=
