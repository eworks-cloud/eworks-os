# Eworks Operator Console — Environment Configuration
# Copy this file to .env.local and fill in your values.
# No absolute paths — all paths are resolved relative to the repo root at runtime.

# ─── Database ──────────────────────────────────────────────────────────────────
# Path to the shared eworks.db SQLite database (relative to repo root), the same
# database the Python agents read/write. Required — the console fails loudly at
# startup if this is unset. Defaults to data/eworks.db in local dev docs, but no
# fallback is hardcoded in code.
EWORKS_DB_PATH=data/eworks.db

# ─── Access ────────────────────────────────────────────────────────────────────
# Shared-secret token required to access the console. Required — the console
# fails loudly at startup if this is unset.
OPERATOR_CONSOLE_ACCESS_TOKEN=your_operator_console_access_token_here
